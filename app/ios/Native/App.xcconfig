PRODUCT_NAME = HyRoute
PRODUCT_BUNDLE_IDENTIFIER = io.hyroute.hyrouteMobile
MARKETING_VERSION = 0.3.17
CURRENT_PROJECT_VERSION = 24
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SWIFT_VERSION = 5.0
SWIFT_OBJC_BRIDGING_HEADER = Runner/HyRouteBridge.h
CLANG_ENABLE_OBJC_ARC = YES
CODE_SIGN_ENTITLEMENTS = Native/PacketTunnel.entitlements
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Native/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = HyRoute
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
OTHER_LDFLAGS = $(inherited) -lresolv
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
